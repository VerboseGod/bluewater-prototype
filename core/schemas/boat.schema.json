{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluewater.local/schemas/boat.schema.json",
  "title": "Dinghy parameters",
  "description": "ILCA/Laser-like hull, rig, and sail constants. SI units: metres, kilograms, seconds, newtons. Angles in the simulation are radians; these values are the coefficients the force model multiplies, not a polar table.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "RHO_AIR", "RHO_WATER", "G", "MASS", "SAIL_AREA", "CREW_MASS", "CE_HEIGHT", "I_ROLL", "I_YAW",
    "HULL_RIGHTING_MANUAL", "HULL_RIGHTING_ASSIST", "ROLL_DAMP",
    "CREW_OFFSET_MIN", "CREW_OFFSET_MAX", "CREW_LEEWARD", "CREW_RATE", "LIGHT_AIR",
    "BOARD_AREA", "BOARD_CLA", "BOARD_AR", "BOARD_STALL",
    "HULL_DRAG_LIN", "HULL_DRAG_QUAD", "HULL_HUMP", "WATERLINE",
    "RUDDER_AREA", "RUDDER_STALL", "RUDDER_STALL_ASSIST", "RUDDER_LEVER", "MAX_RUDDER",
    "WINDAGE", "BOOM_IN", "BOOM_OUT", "OPT_AOA", "TWIST", "STALL_AOA", "STALL_AOA_ASSIST", "LUFF_AOA",
    "WEATHER_HELM", "HEEL_STEER", "WEATHERCOCK", "BOOM_YAW",
    "CAPSIZE_MANUAL", "CAPSIZE_ASSIST", "RECOVERY_TIME", "SHEET_RATE",
    "PLANING_DROP", "PLANING_ONSET", "PLANING_OFF",
    "BEAM_DRIVE", "BEAM_HUMP", "BROAD_DRIVE", "BROAD_DRIVE_AFT", "BROAD_HUMP"
  ],
  "properties": {
    "RHO_AIR": { "type": "number", "description": "Air density, kg/m^3" },
    "RHO_WATER": { "type": "number", "description": "Water density, kg/m^3" },
    "G": { "type": "number", "description": "Gravity, m/s^2" },
    "MASS": { "type": "number", "description": "Boat plus sailor, kg" },
    "SAIL_AREA": { "type": "number", "description": "Sail area, m^2" },
    "CREW_MASS": { "type": "number", "description": "Sailor mass, kg" },
    "CE_HEIGHT": { "type": "number", "description": "Centre of effort height, m" },
    "I_ROLL": { "type": "number", "description": "Roll inertia, kg·m^2" },
    "I_YAW": { "type": "number", "description": "Yaw inertia, kg·m^2" },
    "HULL_RIGHTING_MANUAL": { "type": "number", "description": "Righting moment per sin(heel), N·m" },
    "HULL_RIGHTING_ASSIST": { "type": "number" },
    "ROLL_DAMP": { "type": "number" },
    "CREW_OFFSET_MIN": { "type": "number", "description": "Inboard sitting offset, m, starboard-positive axis" },
    "CREW_OFFSET_MAX": { "type": "number", "description": "Hiked-out offset, m" },
    "CREW_LEEWARD": { "type": "number", "description": "How far the sailor can sit to leeward, m" },
    "CREW_RATE": { "type": "number", "description": "Sailor travel speed at full hike, m/s" },
    "LIGHT_AIR": { "type": "number", "description": "True wind below which hiking out is slow, m/s" },
    "BOARD_AREA": { "type": "number" },
    "BOARD_CLA": { "type": "number" },
    "BOARD_AR": { "type": "number" },
    "BOARD_STALL": { "type": "number", "description": "Board stall angle, rad" },
    "HULL_DRAG_LIN": { "type": "number" },
    "HULL_DRAG_QUAD": { "type": "number" },
    "HULL_HUMP": { "type": "number" },
    "WATERLINE": { "type": "number", "description": "Waterline length, m" },
    "RUDDER_AREA": { "type": "number" },
    "RUDDER_STALL": { "type": "number", "description": "Rudder stall angle, rad" },
    "RUDDER_STALL_ASSIST": { "type": "number" },
    "RUDDER_LEVER": { "type": "number", "description": "Rudder moment arm, m" },
    "MAX_RUDDER": { "type": "number", "description": "Maximum rudder angle, rad" },
    "WINDAGE": { "type": "number", "description": "0.5 * Cd * A for mast, sailor, and topsides" },
    "BOOM_IN": { "type": "number", "description": "Minimum boom angle, rad" },
    "BOOM_OUT": { "type": "number", "description": "Maximum boom angle, rad" },
    "OPT_AOA": { "type": "number", "description": "Optimum angle of attack, rad" },
    "TWIST": { "type": "number" },
    "STALL_AOA": { "type": "number" },
    "STALL_AOA_ASSIST": { "type": "number" },
    "LUFF_AOA": { "type": "number" },
    "WEATHER_HELM": { "type": "number" },
    "HEEL_STEER": { "type": "number" },
    "WEATHERCOCK": { "type": "number" },
    "BOOM_YAW": { "type": "number" },
    "CAPSIZE_MANUAL": { "type": "number", "description": "Heel angle that capsizes, rad" },
    "CAPSIZE_ASSIST": { "type": "number" },
    "RECOVERY_TIME": { "type": "number", "description": "Seconds spent capsized before the boat rights" },
    "SHEET_RATE": { "type": "number", "description": "Sheet travel at full trigger, fraction per second" },
    "PLANING_DROP": { "type": "number" },
    "PLANING_ONSET": { "type": "number", "description": "True wind to get onto a plane, m/s" },
    "PLANING_OFF": { "type": "number", "description": "True wind below which the plane dies, m/s" },
    "BEAM_DRIVE": { "type": "number" },
    "BEAM_HUMP": { "type": "number" },
    "BROAD_DRIVE": { "type": "number" },
    "BROAD_DRIVE_AFT": { "type": "number" },
    "BROAD_HUMP": { "type": "number" }
  }
}
