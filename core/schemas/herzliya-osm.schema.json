{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluewater.local/schemas/herzliya-osm.schema.json",
  "title": "Herzliya harbour extract",
  "description": "Checked-in OpenStreetMap extract at data/herzliya/osm.json. Coordinates are WGS84 degrees. The loader projects them to local metres.",
  "type": "object",
  "required": ["attribution", "licence", "overpass"],
  "properties": {
    "attribution": { "type": "string" },
    "licence": { "type": "string" },
    "licenceName": { "type": "string" },
    "retrieved": { "type": "string" },
    "endpoint": { "type": "string" },
    "query": { "type": "string" },
    "overpass": {
      "type": "object",
      "required": ["elements"],
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": { "type": "string" },
              "id": { "type": "number" },
              "lat": { "type": "number" },
              "lon": { "type": "number" },
              "geometry": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["lat", "lon"],
                  "properties": {
                    "lat": { "type": "number" },
                    "lon": { "type": "number" }
                  }
                }
              },
              "tags": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
